# ─────────────────────────────────────────────────────────────────────────────
# PhysiqO-AI — environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (next to docker-compose.yml) and adjust as needed.
# Never commit the real `.env`. Every value below is a placeholder/default for
# local development — generate strong secrets for any non-local environment.
#
# docker-compose.yml reads these via Compose's automatic `.env` loading.
# The Spring Boot and Python services read them when their Dockerfiles land
# (tasks P0-T02, P0-T05). See docs/DEPLOYMENT.md §4.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by: docker-compose (postgres service), Spring Boot datasource
POSTGRES_DB=physiqo
POSTGRES_USER=physiqo
POSTGRES_PASSWORD=physiqo_dev
# Host-side published port. Container-internal is always 5432. Default 5433
# avoids collisions with other local Postgres installs. See
# docs/ADR/ADR-0001-postgres-dev-host-port.md.
POSTGRES_HOST_PORT=5433

# JDBC URL the Spring Boot backend will use when run on the host
# (./mvnw spring-boot:run). Inside Compose the backend uses `postgres:5432`.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/physiqo

# ── Redis ────────────────────────────────────────────────────────────────────
# Dev runs unauthenticated. Leave empty for local; set for staging/prod.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
# Used by: docker-compose (minio service), Spring Boot storage, Python AI (read)
MINIO_ROOT_USER=physiqo
MINIO_ROOT_PASSWORD=physiqo_dev
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=physiqo-uploads

# ── Spring Boot ──────────────────────────────────────────────────────────────
# 64+ random chars in prod. Generate with:  openssl rand -base64 48
JWT_SECRET=dev-jwt-secret-change-in-production
SPRING_PROFILES_ACTIVE=dev

# CORS — the Vite dev server origin (docs/SECURITY.md §3)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Internal service key (Spring Boot ↔ Python AI) ───────────────────────────
# Must match between the two services. docs/SECURITY.md §5.
AI_SERVICE_KEY=dev-service-key
AI_SERVICE_URL=http://localhost:8000

# ── Python AI service ────────────────────────────────────────────────────────
# One active provider at a time (docs/AI_ARCHITECTURE.md §2).
AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
